# Database Configuration
DATABASE_URL=homeflix.db

# Media Configuration
MEDIA_PATH=/path/to/your/media

# Server Configuration
PORT=8251

# Cache Configuration
CACHE_SIZE=1073741824
CHUNK_SIZE=1048576

# Gemini AI Configuration
GEMINI_API_KEY=gemnini_api_key
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.0-flash-exp

# Redis & Redis Configuration
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0
CELERY_BRIDGE_PORT=5000

# External API Keys
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# YouTube API Configuration (Required for Music Features)
YOUTUBE_API_KEY=your_youtube_api_key_here

# OpenSubtitles Configuration
OPENSUB_API_KEY=sample
OPENSUB_USERNAME=sample
OPENSUB_PASSWORD=sample

# Ollama Configuration (Fallback AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Processing Directories
THUMBNAIL_DIR=./thumbnails
POSTER_DIR=./posters
PREVIEW_DIR=./previews
SUBTITLE_DIR=./subtitles
OPTIMIZED_DIR=./optimized

# Performance Settings
BATCH_SIZE=10
API_URL=http://localhost:8251

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8251
