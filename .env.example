# HomeFlix Application Configuration
# Copy this file to .env and update the values as needed

# ===========================================
# DOCKER & BUILD CONFIGURATION
# ===========================================
# Build target: development (with hot reloading) or production
BUILD_TARGET=development

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=8251
LOG_LEVEL=info
DATABASE_URL=./homeflix.db

# ===========================================
# MEDIA CONFIGURATION
# ===========================================
# Path to your media files (movies/TV shows)
# For Docker: Use absolute path on host machine
# For local development: Use your actual media directory
MEDIA_PATH=/media/azad/Movies

# Media scanning interval in minutes (default: 30 minutes)
# Set to 0 to disable periodic scanning (only scan on startup)
SCAN_INTERVAL_MINUTES=30

# Generated content paths (relative to app directory)
THUMBNAIL_PATH=./thumbnails
POSTER_PATH=./posters
PREVIEW_PATH=./previews
SUBTITLE_PATH=./subtitles
OPTIMIZED_PATH=./optimized

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# For Docker Compose: redis://redis:6379/0
# For local development: redis://localhost:6380/0
REDIS_URL=redis://redis:6379/0

# ===========================================
# CELERY CONFIGURATION
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
C_FORCE_ROOT=1
PYTHONUNBUFFERED=1

# ===========================================
# AI SERVICE API KEYS
# ===========================================
# Google Gemini API (Primary AI service)
GEMINI_API_KEY=your_gemini_api_key_here

# Movie Database APIs (for poster downloads)
TMDB_API_KEY=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJkZjJjZGZmYzVmYzdmYTg1YmYwNjAxNDU3MTYwYTliNCIsIm5iZiI6MTc1OTM4OTI2OC43Niwic3ViIjoiNjhkZTI2NTQ5MDhlZmI4ZjdiNDA1Yjc0Iiwic2NvcGVzIjpbImFwaV9yZWFkIl0sInZlcnNpb24iOjF9.wrM7sOznSRoBPA1G-tz7SojoTBa_VFKTeRf6O88bBo0
OMDB_API_KEY=your_omdb_api_key_here

# ===========================================
# OLLAMA CONFIGURATION (Local AI Fallback)
# ===========================================
# Ollama server URL (for local AI inference)
# Docker: http://host.docker.internal:11434
# Local: http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8251

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Enable hot reloading for development
HOT_RELOAD=true

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================
# Security settings for production
SECURE_COOKIES=true
CORS_ORIGINS=http://localhost:3006,https://yourdomain.com

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
# Flower monitoring dashboard
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:admin123

# ===========================================
# PERFORMANCE TUNING
# ===========================================
# Redis memory limit (for Docker)
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Celery worker concurrency settings
CELERY_METADATA_CONCURRENCY=4
CELERY_THUMBNAILS_CONCURRENCY=6
CELERY_POSTERS_CONCURRENCY=3
CELERY_VIDEO_CONCURRENCY=2
CELERY_SUBTITLES_CONCURRENCY=2
CELERY_SCANNING_CONCURRENCY=1

# Processing Directories
THUMBNAIL_DIR=./thumbnails
POSTER_DIR=./posters
PREVIEW_DIR=./previews
SUBTITLE_DIR=./subtitles
OPTIMIZED_DIR=./optimized

# Performance Settings
BATCH_SIZE=10
API_URL=http://localhost:8251

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8251
