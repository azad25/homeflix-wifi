# Homeflix Backend Environment Configuration

# Database Configuration
DATABASE_URL=postgres://username:password@localhost/homeflix_db

# TMDB (The Movie Database) Configuration
# Get your free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Redis Configuration (for asset caching)
REDIS_URL=redis://localhost:6379/0

# Hardware Acceleration for Transcoding
# Options: none, cuda, vaapi, qsv
HW_ACCEL=none

# Media Library Path
MEDIA_PATH=/path/to/your/media/library

# Server Configuration
PORT=8080
GIN_MODE=release

# Optional: Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: News API Configuration
NEWS_API_KEY=your_news_api_key_here