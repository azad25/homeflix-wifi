FROM golang:1.21-bullseye AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    gcc \
    libc6-dev \
    sqlite3 \
    libsqlite3-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application with optimizations
RUN CGO_ENABLED=1 GOOS=linux go build -a -ldflags '-linkmode external -extldflags "-static"' -o homeflix-server .

FROM debian:bullseye-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    sqlite3 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Create app user
RUN groupadd -r homeflix && useradd -r -g homeflix homeflix

# Copy the binary
COPY --from=builder /app/homeflix-server .

# Create necessary directories with proper permissions
RUN mkdir -p thumbnails posters previews subtitles optimized backdrops logos alac_audio config && \
    chown -R homeflix:homeflix /app

# Switch to app user
USER homeflix

EXPOSE 8252

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8252/api/health || exit 1

CMD ["./homeflix-server"]